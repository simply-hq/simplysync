{
  "version": 1,
  "apps": {
    "visualize-repo": {
      "mode": "local-files",
      "root": ".agent-native/visual-docs",
      "entry": ".agent-native/visual-docs/repo-overview",
      "targets": [
        {
          "id": "engine",
          "name": "TypeScript engine",
          "kind": "area",
          "include": [
            "packages/simplysync-engine/src/engine.ts",
            "packages/simplysync-engine/src/engine"
          ],
          "blocks": ["diagram", "annotated-code", "data-model"],
          "policy": "seed"
        },
        {
          "id": "protocol",
          "name": "Protocol and crypto",
          "kind": "area",
          "include": [
            "packages/simplysync-protocol/src",
            "packages/simplysync-protocol/test/vectors.json"
          ],
          "blocks": ["diagram", "annotated-code"],
          "policy": "seed"
        },
        {
          "id": "platforms",
          "name": "Platform adapters",
          "kind": "area",
          "include": [
            "packages/simplysync-browser/src",
            "packages/simplysync-node/src",
            "packages/simplysync-react/src",
            "packages/simplysync-react-native/src"
          ],
          "blocks": ["file-tree", "table"],
          "policy": "seed"
        },
        {
          "id": "relays",
          "name": "Ciphertext relays",
          "kind": "area",
          "include": [
            "apps/relay-go/handlers.go",
            "apps/relay-go/store.go",
            "apps/relay-cloudflare/src",
            "apps/relay-cloudflare/migrations"
          ],
          "blocks": ["diagram", "api-endpoint", "data-model"],
          "policy": "seed"
        },
        {
          "id": "system-docs",
          "name": "Input-transformation-output docs",
          "kind": "area",
          "include": ["docs/simplysync-system"],
          "blocks": ["file-tree", "table", "diagram"],
          "policy": "seed"
        }
      ],
      "hide": [
        "**/node_modules/**",
        "**/.git/**",
        "**/dist/**",
        "**/build/**",
        "**/.agent-native/**"
      ]
    }
  }
}
