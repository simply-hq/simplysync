{
  "name": "pagination-and-push-batching",
  "devices": {
    "A": { "platform": "$P1" },
    "B": { "platform": "$P2" }
  },
  "relays": [{ "id": "r1", "env": { "DEFAULT_EVENTS_PER_PULL": "25", "MAX_EVENTS_PER_PULL": "25" } }],
  "steps": [
    { "do": "mutate", "device": "A", "table": "account", "rowId": "acct-1", "values": { "name": "Checking", "currency": "USD" } },
    { "do": "mutateRange", "device": "A", "table": "ledger", "rowIdPrefix": "ledger-", "count": 520,
      "values": { "accountId": "acct-1", "amount": -100, "type": "needs", "title": "tx" } },

    { "do": "sync", "device": "A", "relay": "r1", "capture": "s1" },
    { "assert": "equals", "actual": "$s1.pushed", "expected": 521 },

    { "do": "sync", "device": "B", "relay": "r1", "capture": "s2" },
    { "assert": "equals", "actual": "$s2.pulled", "expected": 521 },
    { "assert": "statesEqual", "devices": ["A", "B"] }
  ]
}
