{
  "name": "basic-convergence",
  "devices": {
    "A": { "platform": "$P1" },
    "B": { "platform": "$P2" }
  },
  "relays": [{ "id": "r1" }],
  "steps": [
    { "do": "mutate", "device": "A", "table": "todo", "rowId": "todo-1",
      "values": { "title": "Buy milk", "done": 0 } },
    { "do": "mutate", "device": "A", "table": "todo", "rowId": "todo-2",
      "values": { "title": "Walk the dog", "done": 0 } },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "do": "sync", "device": "B", "relay": "r1" },
    { "assert": "statesEqual", "devices": ["A", "B"] },
    { "assert": "row", "device": "B", "table": "todo", "rowId": "todo-1",
      "expect": { "title": "Buy milk", "done": 0, "isDeleted": 0 } },

    { "do": "mutate", "device": "B", "table": "todo", "rowId": "todo-1",
      "values": { "done": 1 } },
    { "do": "mutate", "device": "B", "table": "todo", "rowId": "todo-3",
      "values": { "title": "Ship TodoList", "done": 0 } },
    { "do": "sync", "device": "B", "relay": "r1" },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "assert": "statesEqual", "devices": ["A", "B"] },
    { "assert": "row", "device": "A", "table": "todo", "rowId": "todo-1",
      "expect": { "done": 1 } },
    { "assert": "rowCount", "device": "A", "table": "todo", "expect": 3 }
  ]
}
