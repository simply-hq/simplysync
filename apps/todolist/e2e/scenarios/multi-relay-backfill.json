{
  "name": "multi-relay-backfill",
  "devices": {
    "A": { "platform": "$P1" },
    "B": { "platform": "$P2" }
  },
  "relays": [{ "id": "r1" }, { "id": "r2" }],
  "steps": [
    { "do": "mutateRange", "device": "A", "table": "todo", "rowIdPrefix": "todo-",
      "count": 10, "values": { "title": "Backfilled todo", "done": 0 } },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "assert": "outboxCount", "device": "A", "expect": 0 },

    { "do": "sync", "device": "A", "relay": "r2" },
    { "assert": "outboxCount", "device": "A", "expect": 0 },
    { "do": "sync", "device": "B", "relay": "r2" },

    { "assert": "statesEqual", "devices": ["A", "B"] },
    { "assert": "rowCount", "device": "B", "table": "todo", "expect": 10 }
  ]
}
