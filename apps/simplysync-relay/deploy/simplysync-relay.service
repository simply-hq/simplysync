# systemd unit for the local-first sync relay.
# Install to /etc/systemd/system/simplysync-relay.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now simplysync-relay
#   sudo systemctl status simplysync-relay
#   journalctl -u simplysync-relay -f        # logs

[Unit]
Description=SimplySync relay
After=network-online.target
Wants=network-online.target
# The relay must not start until Litestream has had a chance to restore the DB
# on a fresh box (see ExecStartPre in DEPLOY.md / litestream restore-on-boot).
After=litestream-restore.service

[Service]
Type=simple
User=simplysync
Group=simplysync
WorkingDirectory=/opt/simplysync-relay

# Single bundled file produced by `bun build` (see DEPLOY.md). No node_modules
# or workspace needed on the box.
ExecStart=/usr/local/bin/bun run /opt/simplysync-relay/relay.js

Environment=PORT=4100
Environment=RELAY_DATA_DIR=/var/lib/simplysync-relay
# Operational dashboard. Set a strong, random token to enable it; unset =>
# disabled (every admin path 404s). The dashboard is served at a SECRET base
# path derived from the token (e.g. /ops-<hash>), not /admin — the resolved
# path is printed to this service's log at startup (journalctl -u simplysync-relay).
# Optionally pin a custom path with ADMIN_PATH=/your-secret-path.
# Environment=ADMIN_TOKEN=change-me-to-a-long-random-string
# Environment=ADMIN_PATH=/your-secret-path
# Quota tunables (match the Cloudflare deploy's defaults; override as needed):
Environment=MAX_OWNER_BYTES=1073741824
Environment=MAX_EVENT_BYTES=262144
Environment=MAX_BLOB_BYTES=8388608
# Log compaction interval in ms (drops superseded edits so the DB stops growing
# and quotas reflect current footprint). Default 6h; set "0" to disable.
Environment=COMPACTION_INTERVAL_MS=21600000

Restart=always
RestartSec=2

# --- Hardening: the relay only needs to write its data dir. ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/simplysync-relay
# Listen on localhost only; Caddy (or Cloudflare tunnel) terminates TLS in front.
# Bind to 127.0.0.1 by running behind the reverse proxy in Caddyfile.

[Install]
WantedBy=multi-user.target
