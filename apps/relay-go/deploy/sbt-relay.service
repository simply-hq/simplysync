# systemd unit for the Go relay (single static binary — no runtime to install).
# Install to /etc/systemd/system/sbt-relay.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sbt-relay
#   journalctl -u sbt-relay -f
#
# Litestream (backups) and Caddy (TLS) use the adjacent deployment files.

[Unit]
Description=SBT local-first sync relay (Go)
After=network-online.target litestream-restore.service
Wants=network-online.target

[Service]
Type=simple
User=sbtrelay
Group=sbtrelay
WorkingDirectory=/opt/sbt-relay
ExecStart=/opt/sbt-relay/relay

Environment=PORT=4100
Environment=RELAY_DATA_DIR=/var/lib/sbt-relay
# Quota tunables (match the other relays' defaults; override as needed):
Environment=MAX_OWNER_BYTES=1073741824
Environment=MAX_EVENT_BYTES=262144
Environment=MAX_BLOB_BYTES=8388608
# Log compaction interval in ms ("0" disables). Default 6h.
Environment=COMPACTION_INTERVAL_MS=21600000
# Ops dashboard: set a strong token to enable it (served at a secret path
# derived from the token, logged at startup). Unset => disabled (404).
# Environment=ADMIN_TOKEN=change-me-to-a-long-random-string
# Environment=ADMIN_PATH=/your-secret-path

Restart=always
RestartSec=2

# Hardening: the relay only needs to write its data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sbt-relay

[Install]
WantedBy=multi-user.target
