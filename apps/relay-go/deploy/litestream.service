# systemd unit for Litestream continuous replication.
# Install to /etc/systemd/system/litestream.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now litestream

[Unit]
Description=Litestream (SQLite replication for sbt-relay)
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=2
EnvironmentFile=/etc/sbt-relay/litestream.env
ExecStart=/usr/bin/litestream replicate -config /etc/sbt-relay/litestream.yml

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sbt-relay

[Install]
WantedBy=multi-user.target
