# One-shot: on boot, restore the DB from R2 *only if it's missing* (fresh box or
# disaster recovery). On a healthy box the file already exists, so this is a
# no-op and the relay starts with its live data. The relay unit orders itself
# After= this, so it never starts against an empty DB on a rebuild.
#
# Install to /etc/systemd/system/litestream-restore.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable litestream-restore   # runs at boot, before simplysync-relay

[Unit]
Description=Restore simplysync-relay SQLite from object storage if missing
After=network-online.target
Wants=network-online.target
Before=simplysync-relay.service

[Service]
Type=oneshot
RemainAfterExit=true
EnvironmentFile=/etc/simplysync-relay/litestream.env
# `-if-db-not-exists -if-replica-exists` makes this safe to run unconditionally.
ExecStart=/usr/bin/litestream restore -if-db-not-exists -if-replica-exists \
  -config /etc/simplysync-relay/litestream.yml /var/lib/simplysync-relay/relay.db

[Install]
WantedBy=multi-user.target
