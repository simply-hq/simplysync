.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders (only top-level prebuild output, not local Expo modules)
apps/*/ios
apps/*/android
apps/*/*/ios
apps/*/*/android

# Local Expo module build outputs (Kotlin/Gradle). The clients live one level
# deeper than the app group (apps/todolist/expo), so both depths are listed.
apps/*/modules/*/android/build/
apps/*/modules/*/android/.gradle/
apps/*/modules/*/android/.cxx/
apps/*/modules/*/ios/build/
apps/*/modules/*/ios/Pods/
apps/*/modules/*/ios/*.xcodeproj/xcuserdata/
apps/*/modules/*/ios/*.xcworkspace/xcuserdata/
apps/*/*/modules/*/android/build/
apps/*/*/modules/*/android/.gradle/
apps/*/*/modules/*/android/.cxx/
apps/*/*/modules/*/ios/build/
apps/*/*/modules/*/ios/Pods/
apps/*/*/modules/*/ios/*.xcodeproj/xcuserdata/
apps/*/*/modules/*/ios/*.xcworkspace/xcuserdata/

# Maestro E2E test results
test-results/


# Claude Code - local settings only
.claude/settings.local.json

*.aab

# Compiled relay-go binary (build artifact)
apps/relay-go/sbt-relay-go

# Installed agent skills (reproducible from skills-lock.json). Keep the
# repo-owned relay-hosting skill available in fresh clones.
.agents/skills/*
!.agents/skills/host-relay/
!.agents/skills/host-relay/**
!.agents/skills/clone-simplysync/
!.agents/skills/clone-simplysync/**
