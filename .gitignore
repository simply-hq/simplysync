# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Turborepo
.turbo

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local environment and secret files (example templates remain trackable)
**/.env
**/.env.*
!**/.env.example

# typescript
*.tsbuildinfo

app-example

# generated native folders (only top-level prebuild output, not local Expo modules)
apps/*/ios
apps/*/android

# Local Expo module build outputs (Kotlin/Gradle)
apps/*/modules/*/android/build/
apps/*/modules/*/android/.gradle/
apps/*/modules/*/android/.cxx/
apps/*/modules/*/ios/build/
apps/*/modules/*/ios/Pods/
apps/*/modules/*/ios/*.xcodeproj/xcuserdata/
apps/*/modules/*/ios/*.xcworkspace/xcuserdata/

# Maestro E2E test results
test-results/


# Claude Code - local settings only
.claude/settings.local.json

*.aab

# Compiled relay-go binary (build artifact)
apps/relay-go/simplysync-relay-go

# Installed agent skills (reproducible from skills-lock.json). Keep the
# repo-owned relay-hosting skill available in fresh clones.
.agents/skills/*
!.agents/skills/host-relay/
!.agents/skills/host-relay/**
