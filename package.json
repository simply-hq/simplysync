{
  "name": "simplysync",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, end-to-end-encrypted local-first sync engine. Clone it and use it as you see fit.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "relay:go": "cd apps/relay-go && go run .",
    "demo": "bun run --cwd apps/simplysync-example demo:with-relay",
    "expo": "bun run --cwd apps/simplysync-expo start",
    "docs:dev": "bun run --cwd apps/simplysync-docs dev",
    "kotlin:test": "cd apps/simplysync-android-kotlin && ./gradlew test",
    "app-port:check": "node scripts/check-native-app-port-drift.mjs",
    "app-port:update": "node scripts/check-native-app-port-drift.mjs --update",
    "sync:diff": "node scripts/diff-sync-port.mjs"
  },
  "devDependencies": {
    "turbo": "2.9.16"
  }
}
