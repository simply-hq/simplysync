{
  "name": "simplysync",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, end-to-end-encrypted local-first sync engine. Clone it and use it as you see fit.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "relays/*",
    "examples/*",
    "docs/site",
    "tests/*"
  ],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "relay:go": "cd relays/go && go run .",
    "relay:cloudflare:setup": "bun run --cwd relays/cloudflare setup",
    "demo": "bun run --cwd examples/cli demo:with-relay",
    "expo": "bun run --cwd examples/expo start",
    "docs:dev": "bun run --cwd docs/site dev",
    "kotlin:test": "cd ports/kotlin && ./gradlew test",
    "app-e2e": "bun run --cwd tests/app-e2e e2e",
    "app-port:check": "node scripts/check-native-app-port-drift.mjs",
    "app-port:update": "node scripts/check-native-app-port-drift.mjs --update",
    "sync:diff": "node scripts/diff-sync-port.mjs",
    "security:bip39": "bun run --cwd packages/simplysync-protocol security:bip39"
  },
  "devDependencies": {
    "turbo": "2.9.16"
  }
}
