{
  "name": "@simplysync/react",
  "version": "0.0.1",
  "description": "React bindings for the SimplySync local-first engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-hq/simplysync.git",
    "directory": "packages/simplysync-react"
  },
  "keywords": ["local-first", "offline-first", "sync", "react", "e2ee"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplysync/engine": "0.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "react": "19.2.0",
    "typescript": "~5.9.2"
  }
}
