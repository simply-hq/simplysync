{
  "name": "@simplysync/react-native",
  "version": "0.0.1",
  "description": "React Native bindings and Expo persistence adapters for SimplySync.",
  "homepage": "https://simplysync.org/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-hq/simplysync.git",
    "directory": "packages/simplysync-react-native"
  },
  "keywords": ["local-first", "offline-first", "sync", "react-native", "expo", "e2ee"],
  "type": "module",
  "sideEffects": ["./dist/install.js"],
  "files": ["dist", "metro", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js",
      "default": "./dist/install.js"
    },
    "./metro": {
      "types": "./metro/index.d.cts",
      "require": "./metro/index.cjs",
      "default": "./metro/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@simplysync/engine": "0.0.1",
    "@simplysync/react": "0.0.1"
  },
  "peerDependencies": {
    "expo": ">=52.0.0 <56.0.0",
    "expo-secure-store": ">=14.0.0 <56.0.0",
    "expo-sqlite": ">=15.0.0 <56.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-native": ">=0.76.0 <0.84.0",
    "react-native-nitro-modules": ">=0.31.0 <1.0.0",
    "react-native-quick-base64": ">=3.0.0 <4.0.0",
    "react-native-quick-crypto": ">=1.1.0 <2.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.16",
    "expo": "55.0.5",
    "expo-secure-store": "55.0.14",
    "expo-sqlite": "55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-nitro-modules": "0.34.1",
    "react-native-quick-base64": "3.0.0",
    "react-native-quick-crypto": "1.1.5",
    "typescript": "~5.9.2"
  }
}
