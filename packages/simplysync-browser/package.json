{
  "name": "@simplysync/browser",
  "version": "0.0.1",
  "description": "Production browser persistence and encrypted storage adapters for SimplySync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-hq/simplysync.git",
    "directory": "packages/simplysync-browser"
  },
  "keywords": ["local-first", "offline-first", "sync", "indexeddb", "e2ee"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@simplysync/engine": "0.0.1",
    "@simplysync/protocol": "0.0.1",
    "@types/sql.js": "1.4.11",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "~5.9.2"
  }
}
