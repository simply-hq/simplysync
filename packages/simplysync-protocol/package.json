{
  "name": "@simplysync/protocol",
  "version": "0.0.1",
  "description": "Cross-platform identity, encryption, and wire types for SimplySync.",
  "homepage": "https://simplysync.org/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-hq/simplysync.git",
    "directory": "packages/simplysync-protocol"
  },
  "keywords": ["local-first", "offline-first", "sync", "encryption", "e2ee"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "gen:vectors": "bun run scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@scure/bip39": "2.2.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
