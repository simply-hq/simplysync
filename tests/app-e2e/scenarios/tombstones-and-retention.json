{
  "name": "tombstones-and-retention",
  "devices": {
    "A": { "platform": "$P1" },
    "B": { "platform": "$P2" },
    "C": { "platform": "$P1" }
  },
  "relays": [{ "id": "r1" }],
  "steps": [
    { "do": "mutate", "device": "A", "table": "account", "rowId": "acct-1", "values": { "name": "Checking", "currency": "USD" } },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "do": "sync", "device": "B", "relay": "r1" },
    { "assert": "row", "device": "B", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 0 } },

    { "do": "mutate", "device": "A", "table": "account", "rowId": "acct-1", "op": "delete", "values": {} },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "do": "sync", "device": "B", "relay": "r1" },
    { "assert": "row", "device": "B", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 1 } },

    { "do": "purgeRows", "device": "B", "rows": [{ "table": "account", "rowId": "acct-1" }], "requirePushed": true, "capture": "purge" },
    { "assert": "equals", "actual": "$purge.purged", "expected": 0 },
    { "assert": "row", "device": "B", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 1 } },

    { "do": "sync", "device": "B", "relay": "r1" },
    { "assert": "row", "device": "B", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 1 } },

    { "do": "sync", "device": "C", "relay": "r1" },
    { "assert": "row", "device": "C", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 1 } },

    { "assert": "row", "device": "A", "table": "account", "rowId": "acct-1", "expect": { "isDeleted": 1 } }
  ]
}
