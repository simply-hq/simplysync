{
  "name": "auth-rejection",
  "devices": {
    "A": { "platform": "$P1" }
  },
  "relays": [{ "id": "r1" }],
  "steps": [
    { "do": "mutate", "device": "A", "table": "account", "rowId": "acct-1", "values": { "name": "Checking", "currency": "USD" } },
    { "do": "sync", "device": "A", "relay": "r1" },
    { "do": "pruneOutbox", "device": "A", "relays": ["r1"] },
    { "assert": "outboxCount", "device": "A", "expect": 0 },

    { "do": "rawPush", "device": "A", "relay": "r1", "authOverride": "deadbeefdeadbeef", "capture": "rp" },
    { "assert": "equals", "actual": "$rp.threw", "expected": true },
    { "assert": "equals", "actual": "$rp.kind", "expected": "authRejected" },
    { "assert": "outboxCount", "device": "A", "expect": 0 },

    { "do": "mutate", "device": "A", "table": "account", "rowId": "acct-2", "values": { "name": "Savings", "currency": "USD" } },
    { "do": "sync", "device": "A", "relay": "r1", "capture": "s2" },
    { "assert": "atLeast", "actual": "$s2.pushed", "expected": 1 }
  ]
}
